---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RankList from '../../components/RankList.astro';
import RankTabs from '../../components/RankTabs.astro';
import SubChips from '../../components/SubChips.astro';
import { getCategory, getItems, getSubcategoryPaths, getUpdatedAt, GROUPS, windowLabel } from '../../lib/rankings';
import { formatUpdatedAt } from '../../../scripts/lib/format.mjs';
import { withBase } from '../../lib/url';
import type { WindowId } from '../../types';

export function getStaticPaths() {
  return getSubcategoryPaths().map(({ group, slug }) => ({ params: { group, slug } }));
}

const { group: groupId, slug: categoryId } = Astro.params;
const group = GROUPS.find((item) => item.id === groupId);
const category = getCategory(categoryId as string);
const items = getItems(categoryId as string, 'total' as WindowId);
const updatedAt = getUpdatedAt();
const label = `${category?.name}${windowLabel('total' as WindowId)}`;
const isFramework = category?.kind === 'framework';
---

<BaseLayout title={`${category?.name}${windowLabel('total' as WindowId)}`} description={`${group?.name}分类下 ${category?.name} 的 GitHub 仓库总星排行榜。`}>
  <Header />

  <main class="mx-auto max-w-5xl px-4 py-8">
    <nav class="text-xs text-muted" aria-label="面包屑">
      <a href={withBase('/')} class="hover:text-brand-ink">首页</a>
      <span class="mx-1.5">/</span>
      <a href={withBase(`/${group?.id}/`)} class="hover:text-brand-ink">{group?.name}</a>
      <span class="mx-1.5">/</span>
      <span>{category?.name}</span>
    </nav>

    <h1 class="mt-2 text-2xl font-semibold tracking-tight">{category?.name}排行榜</h1>
    <p class="mt-2 text-sm text-muted">更新于 {formatUpdatedAt(updatedAt)}</p>

    {
      isFramework && (
        <p class="mt-3 rounded border border-line bg-card px-3 py-2 text-xs leading-relaxed text-muted">
          本页按 GitHub topic「{category?.queries[0]?.topic}」归集，并用 {category?.langFilter?.join(' / ')} 主语言白名单过滤。
          框架只提供总星榜：topic 下 90 天内新建的项目太少，新星/活跃榜会出现只有个位数条目的空页。
        </p>
      )
    }

    {
      (category?.windows.length ?? 0) > 1 && (
        <section class="mt-5" aria-label="榜单口径切换">
          <RankTabs group={group?.id ?? ''} slug={categoryId as string} active={'total' as WindowId} />
        </section>
      )
    }

    {group && <section class="mt-5" aria-label="子类导航"><SubChips group={group.id} active={category?.id} /></section>}

    <section class="mt-6" aria-label={label}>
      <RankList items={items} label={label} showLanguage={group?.id !== 'dev'} />
    </section>
  </main>

  <Footer />
</BaseLayout>
