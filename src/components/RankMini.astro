---
import { formatStars } from '../../scripts/lib/format.mjs';
import { languageDot } from '../../scripts/lib/color.mjs';
import type { Repo } from '../types';

interface Props {
  repo: Repo;
}

const { repo } = Astro.props;
const dot = repo.language ? languageDot(repo.language) : null;
---

<li class="rank-row relative flex min-w-0 items-center gap-3 rounded-lg border border-line px-3 py-2">
  <span class="w-5 shrink-0 text-right text-xs font-semibold tabular-nums text-muted" aria-hidden="true">
    {repo.rank}
  </span>

  <a
    href={repo.url}
    target="_blank"
    rel="noopener noreferrer"
    class="min-w-0 flex-1 truncate font-medium text-brand-ink after:absolute after:inset-0 after:content-[''] focus-visible:outline-none"
    aria-label={`在 GitHub 打开 ${repo.fullName}（新标签页）`}
  >
    <span class="truncate">{repo.fullName}</span>
    <svg class="ml-1 inline h-3 w-3 align-[-1px]" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path d="M6 3h7v7M13 3 4 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </a>

  <span class="shrink-0 text-xs tabular-nums text-muted">{formatStars(repo.stars)}</span>
  {
    repo.language && dot && (
      <span class="hidden w-[4.5rem] shrink-0 items-center justify-end gap-1.5 text-xs text-muted sm:flex">
        <span class="lang-dot" style={`--lang:${dot.light};--lang-dark:${dot.dark}`} aria-hidden="true" />
        <span class="truncate">{repo.language}</span>
      </span>
    )
  }
</li>
