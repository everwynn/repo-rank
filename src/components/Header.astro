---
import { GROUPS } from '../lib/rankings';
import { withBase } from '../lib/url';
import ThemeToggle from './ThemeToggle.astro';

const links = [
  ...GROUPS.map((group) => ({ href: withBase(`/${group.id}/`), label: group.name })),
  { href: withBase('/sources/'), label: '数据来源' },
  { href: withBase('/about/'), label: '关于' },
];
---

<header class="border-b border-line bg-card">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-4 gap-y-2 px-4 py-3">
    <a href={withBase('/')} class="text-sm font-semibold tracking-tight">开源榜</a>

    <nav class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm" aria-label="主导航">
      {
        links.map((link) => (
          <a href={link.href} class="text-muted transition-colors hover:text-brand-ink">
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto">
      <ThemeToggle />
    </div>
  </div>
</header>
