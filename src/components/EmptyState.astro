---
interface Props {
  label: string;
  hint?: string;
}

const { label, hint = '本期数据还没抓取。运行 npm run fetch 后再构建即可看到榜单。' } = Astro.props;
---

<div class="rounded-lg border border-dashed border-line bg-card p-8 text-center">
  <p class="text-sm font-medium">{label}暂无数据</p>
  <p class="mx-auto mt-2 max-w-md text-xs leading-relaxed text-muted">{hint}</p>
</div>
