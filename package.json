{
  "name": "repo-rank",
  "type": "module",
  "version": "0.1.0",
  "private": false,
  "description": "GitHub 仓库排行榜：按开发语言 / 书籍 / 音频分类，静态部署到 GitHub Pages",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "fetch": "node scripts/fetch.mjs",
    "probe": "node scripts/probe.mjs",
    "check": "astro check",
    "test": "node --test tests/"
  },
  "dependencies": {
    "@astrojs/tailwind": "^5.1.5",
    "astro": "^4.16.19",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/node": "^26.6.6",
    "pagefind": "^1.2.0",
    "typescript": "^5.6.3"
  }
}
